operties":{"id":"french-police","name_zh":"法国巡捕房","name_en":"Former French Police Station","address":"沙面大街1号","category":"military","built_year":1890,"built_label":"约1890年代","built_precision":"decade","visible_from":1890,"renovated":[],"architect":"未详","original_use":"警察局","current_use":"办公","style":"殖民地外廊式","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"法国巡捕房位于沙面大街1号，是法租界的警察机构，约建于1890年代。建筑为两层殖民地外廊式，入口设门廊，立面简洁。1946年租界收回后改作其他用途，现属沙面建筑群全国重点文物保护单位。","events":["e-1946"],"sources":["广州市情网","广州市文物考古研究院","Wikimedia Commons"],"confidence":"medium","geometry_precision":"polygon","osm_id":982039450,"images":[{"src":"./assets/img/buildings/french-police.webp","caption":"沙面大街1号外立面（2023）","credit":"Inclavatura","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E6%B2%99%E9%9D%A2%E5%A4%A7%E8%A1%971%E5%8F%B7.jpg"}],"center":[23.109671,113.243733]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.243666,23.10914],[113.243675,23.109522],[113.243847,23.109519],[113.243838,23.109136],[113.243666,23.10914]]]},"properties":{"id":"moor","name_zh":"旧摩罗叉公寓","name_en":"Former Moor Apartments","address":"沙面南街2、4、6、8、10号","category":"hotel","built_year":1870,"built_label":"约1870年代","built_precision":"century","visible_from":1870,"renovated":[],"architect":"未详","original_use":"公寓/住宅（印度人住宅）","current_use":"商业/办公","style":"殖民地外廊式","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"旧摩罗叉公寓又称沙面南街印度人住宅旧址，位于沙面南街2、4、6、8、10号，建于19世纪下半叶。“摩罗叉”为近代广州对外籍印度人的旧称，建筑反映了租界时期的人口构成。文物名录将年代记为19世纪下半叶，本页在时间轴上以约1870年代作为近似显示起点。","events":[],"sources":["广州市荔湾区不可移动文物名录（19世纪下半叶）","百度百科“沙面南街印度人住宅旧址”","Wikimedia Commons"],"confidence":"medium","geometry_precision":"polygon","osm_id":352610272,"images":[{"src":"./assets/img/buildings/moor.webp","caption":"沙面南街2、4、6、8、10号沿街立面（2023）","credit":"Inclavatura","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E6%B2%99%E9%9D%A2%E5%8D%97%E8%A1%972%E3%80%814%E3%80%816%E3%80%818%E3%80%8110%E5%8F%B7.jpg"}],"center":[23.109329,113.243757]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.241621,23.110068],[113.241846,23.110063],[113.24184,23.109851],[113.241615,23.109856],[113.241621,23.110068]]]},"properties":{"id":"british-hospital","name_zh":"英国医院&招商局旧址","name_en":"Former British Hospital & China Merchants","address":"沙面大街22、24号","category":"public","built_year":1932,"built_label":"1932","built_precision":"exact","visible_from":1932,"renovated":[],"architect":"未详","original_use":"医院/招商局","current_use":"办公","style":"现代主义/装饰艺术倾向","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"英国医院旧址位于沙面大街22、24号，1932年建成，楼高约15.7米，建筑面积约1642平方米。民国年间曾先后用作英国医院与招商局，是沙面医疗卫生建筑的代表。现属沙面建筑群全国重点文物保护单位。","events":[],"sources":["广州市文物局关于英国医院旧址装修事宜的复函","广州市荔湾区不可移动文物名录","Wikimedia Commons"],"confidence":"high","geometry_precision":"polygon","osm_id":352610320,"images":[{"src":"./assets/img/buildings/british-hospital.webp","caption":"沙面大街22、24号沿街立面（2023）","credit":"Inclavatura","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E6%B2%99%E9%9D%A2%E5%A4%A7%E8%A1%9722%E3%80%8124%E5%8F%B7.jpg"}],"center":[23.109959,113.24173]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.237533,23.110248],[113.237532,23.110175],[113.237524,23.110112],[113.237529,23.110071],[113.237522,23.110037],[113.237433,23.110039],[113.237435,23.110103],[113.237421,23.110091],[113.237391,23.110091],[113.237378,23.110104],[113.237376,23.110041],[113.237202,23.110045],[113.237204,23.110141],[113.237173,23.110142],[113.237176,23.110259],[113.237218,23.110258],[113.23722,23.110326],[113.237283,23.110325],[113.237281,23.110253],[113.237382,23.110251],[113.237533,23.110248]]]},"properties":{"id":"foreign-club","name_zh":"广东外事俱乐部","name_en":"Guangdong Foreign Affairs Club","address":"沙面大街60号","category":"public","built_year":1865,"built_label":"1865（1868年设广州俱乐部）","built_precision":"exact","visible_from":1865,"renovated":["2013—2014"],"architect":"未详","original_use":"俱乐部","current_use":"外事俱乐部","style":"殖民地外廊式","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"广东外事俱乐部位于沙面大街60号，前身为1865年建成的广州俱乐部（Canton Club，又称群英会），1868年正式在此设会馆。建筑为殖民地外廊式，设有宽敞廊道与集会空间，2013—2014年全面修缮，现由广东省外事部门管理使用。","events":[],"sources":["中文维基百科“群英会（俱乐部）”（1865）","广州市荔湾区不可移动文物名录","Wikimedia Commons"],"confidence":"high","geometry_precision":"polygon","osm_id":982457851,"images":[{"src":"./assets/img/buildings/foreign-club.webp","caption":"沙面大街60号外立面（2023）","credit":"Inclavatura","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E6%B2%99%E9%9D%A2%E5%A4%A7%E8%A1%9760%E5%8F%B7.jpg"}],"center":[23.110156,113.237361]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.239862,23.11068],[113.239937,23.110678],[113.240281,23.11067],[113.240357,23.110668],[113.240352,23.110473],[113.240346,23.110242],[113.240126,23.110246],[113.240128,23.110321],[113.239852,23.110327],[113.239857,23.110485],[113.239862,23.11068]]]},"properties":{"id":"victory-hotel","name_zh":"广东胜利宾馆（原维多利亚酒店）","name_en":"Guangdong Victory Hotel (Former Victoria Hotel)","address":"沙面北街53号","category":"hotel","built_year":1888,"built_label":"1888（1895年改称维多利亚酒店）","built_precision":"exact","visible_from":1888,"renovated":[],"architect":"未详","original_use":"酒店","current_use":"酒店","style":"殖民地外廊式/新古典主义","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"广东胜利宾馆位于沙面北街53号，其前身为1888年开业的Shameen Hotel，1895年改称维多利亚酒店（Victoria Hotel），是沙面租界历史最悠久的酒店之一。建筑临江，设外廊与庭院；1950年代后改称胜利宾馆。现属沙面建筑群全国重点文物保护单位。","events":["e-1946"],"sources":["OpenStreetMap 旧名标注","Wikimedia Commons","广州市情网"],"confidence":"high","geometry_precision":"polygon","osm_id":1518044190,"images":[{"src":"./assets/img/buildings/victory-hotel.webp","caption":"维多利亚酒店旧影（约1900）","credit":"Unknown author","license":"Public domain","license_url":"","source_url":"https://commons.wikimedia.org/wiki/File:Victoria_Hotel_Shameen_Canton_c1900.jpg"}],"center":[23.110479,113.24011]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.23759,23.1097],[113.237627,23.109699],[113.23762,23.109518],[113.237582,23.10952],[113.237587,23.10964],[113.237569,23.109641],[113.237564,23.109535],[113.237401,23.109541],[113.237408,23.109707],[113.237446,23.109705],[113.237446,23.109696],[113.237589,23.109691],[113.23759,23.1097]]]},"properties":{"id":"exhibition","name_zh":"沙面展览馆（天祥洋行旧址）","name_en":"Shamian Exhibition Hall (Former Tianxiang Foreign Firm)","address":"沙面大街61-1号","category":"public","built_year":1924,"built_label":"1924","built_precision":"exact","visible_from":1924,"renovated":[],"architect":"未详","original_use":"洋行","current_use":"展览馆","style":"折衷主义/殖民地外廊式","heritage_status":"全国重点文物保护单位（沙面建筑群组成部分）","summary":"沙面展览馆位于沙面大街61-1号，建筑前身为英商天祥洋行（Dodwell & Co.）广州分部旧址，1924年建成。立面三段式，采用爱奥尼柱式、梁托与铁艺栏杆，呈折衷主义风格。现作沙面展览馆，属沙面建筑群全国重点文物保护单位。","events":[],"sources":["广州市荔湾区第三次全国文物普查名录（1924）","中文维基百科“天祥洋行旧址”","Wikimedia Commons"],"confidence":"high","geometry_precision":"polygon","osm_id":956516988,"images":[{"src":"./assets/img/buildings/exhibition.webp","caption":"沙面大街61号外立面（2023）","credit":"Inclavatura","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E6%B2%99%E9%9D%A2%E5%A4%A7%E8%A1%9761%E5%8F%B7.jpg"}],"center":[23.109633,113.237536]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.245528,23.110018],[113.24553,23.1098],[113.245948,23.109978],[113.245938,23.110192],[113.245528,23.110018]]]},"properties":{"id":"customs-house","name_zh":"粤海关旧址","name_en":"Canton Custom House","address":"邻近沙面·沿江西路（门牌未详）","category":"surrounding","built_year":1916,"built_label":"1916","built_precision":"exact","visible_from":1916,"renovated":[],"architect":"未详","original_use":"海关","current_use":"中国海关博物馆广州分馆","style":"新古典主义/折衷主义","heritage_status":"全国重点文物保护单位","summary":"粤海关旧址位于沙面岛东侧、沿江西路，1916年6月建成，是近代广州海关的办公大楼。建筑以钟楼为中心，立面采用新古典主义构图，是珠江沿岸的重要地标。现为中国海关博物馆广州分馆，全国重点文物保护单位。","events":[],"sources":["OpenStreetMap 标注 start_date=1916-06-25","Wikimedia Commons","广州市情网"],"confidence":"high","geometry_precision":"polygon","osm_id":331715161,"images":[{"src":"./assets/img/buildings/customs-house.webp","caption":"粤海关旧址钟楼立面","credit":"Time-137","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:%E7%B2%A4%E6%B5%B7%E5%85%B3%E5%A4%A7%E6%A5%BC.jpg"}],"center":[23.109997,113.245736]}},{"type":"Feature","geometry":{"type":"Polygon","coordinates":[[[113.245223,23.111836],[113.245238,23.111413],[113.245942,23.111433],[113.245928,23.111857],[113.245223,23.111836]]]},"properties":{"id":"thirteen-hongs","name_zh":"广州十三行博物馆","name_en":"Guangzhou Thirteen Hongs Museum","address":"邻近沙面·广州文化公园内","category":"surrounding","built_year":2016,"built_label":"2016","built_precision":"exact","visible_from":2016,"renovated":[],"architect":"未详","original_use":"展览建筑（文化公园展览中心改造）","current_use":"博物馆","style":"现代展览建筑","heritage_status":"非文物保护单位","summary":"广州十三行博物馆位于沙面岛东北侧的文化公园内，2016年9月30日开放，由文化公园展览中心改造而成。馆藏以清代广州十三行、外销艺术品与中外贸易文物为主题，是理解沙面租界前广州贸易体系的重要周边节点。","events":[],"sources":["中文维基百科“广州十三行博物馆”","Wikimedia Commons","OpenStreetMap"],"confidence":"high","geometry_precision":"polygon","osm_id":1078865557,"images":[{"src":"./assets/img/buildings/thirteen-hongs.webp","caption":"广州十三行博物馆正门（2021）","credit":"PQ77wd","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0","source_url":"https://commons.wikimedia.org/wiki/File:Canton_Thirteen_Hong_Museum.jpg"}],"center":[23.111635,113.245583]}}]}